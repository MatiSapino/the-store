---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ dashboards_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-ops-view
  namespace: {{ dashboards_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kube-ops-view
rules:
  - apiGroups: [""]
    resources: ["nodes", "pods", "services"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kube-ops-view
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kube-ops-view
subjects:
  - kind: ServiceAccount
    name: kube-ops-view
    namespace: {{ dashboards_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kube-ops-view
  namespace: {{ dashboards_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: kube-ops-view
  template:
    metadata:
      labels:
        app: kube-ops-view
    spec:
      serviceAccountName: kube-ops-view
      nodeSelector:
        kubernetes.io/hostname: {{ k3s_ingress_node_name }}
      tolerations:
        - key: CriticalAddonsOnly
          operator: Exists
      containers:
        - name: service
          image: {{ kube_ops_view_image }}
          args: ["--port=8080"]
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
          resources:
            limits:
              memory: 128Mi
            requests:
              cpu: 50m
              memory: 64Mi
---
apiVersion: v1
kind: Service
metadata:
  name: kube-ops-view
  namespace: {{ dashboards_namespace }}
spec:
  type: NodePort
  selector:
    app: kube-ops-view
  ports:
    - port: 80
      targetPort: 8080
      nodePort: {{ kube_ops_view_nodeport }}
